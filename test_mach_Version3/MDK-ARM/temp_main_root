/* ================= STATE MACHINE ================= */
/* Motor 1: chu trinh S1 -> S3 (chieu A), hoac S3 -> S1 (chieu B) */
typedef enum
{
  M1_IDLE = 0,

  M1_RUN_S1_TO_S3,      // S1 nhan -> k?ch A11, chay tai S3
  M1_HOLD_AT_S3,        // S3 nhan -> k?ch A11 + A12, gia tai khi S3 mat

  M1_RUN_S3_TO_S1,      // S3 nhan -> k?ch A12, chay tai S1
  M1_HOLD_AT_S1         // S1 nhan -> k?ch A11 + A12, gia tai khi S1 mat
} M1_State_t;

/* Motor 2: chu trinh S2 -> S4 (chieu A), hoac S4 -> S2 (chieu B) */
typedef enum
{
  M2_IDLE = 0,

  M2_RUN_S2_TO_S4,      // S2 nhan -> k?ch A15, chay tai S4
  M2_HOLD_AT_S4,        // S4 nhan -> k?ch A15 + B3, gia tai khi S4 mat

  M2_RUN_S4_TO_S2,      // S4 nhan -> k?ch B3, chay tai S2
  M2_HOLD_AT_S2         // S2 nhan -> k?ch A15 + B3, gia tai khi S2 mat
} M2_State_t;

M1_State_t m1_state = M1_IDLE;
M2_State_t m2_state = M2_IDLE;

/* =================== PIN HELPERS =================== */
