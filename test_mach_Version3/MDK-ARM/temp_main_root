void Audio_Clear(void)
{
		HAL_GPIO_WritePin(GPIOB, AUDIO_ALL_PIN, GPIO_PIN_RESET);
}

void Audio_SendHex(uint8_t code)
{
		HAL_GPIO_WritePin(AUDIO_B4_PORT, AUDIO_B4_PIN, (code & 0x10) ? GPIO_PIN_SET : GPIO_PIN_RESET);
		HAL_GPIO_WritePin(AUDIO_B3_PORT, AUDIO_B3_PIN, (code & 0x08) ? GPIO_PIN_SET : GPIO_PIN_RESET);
		HAL_GPIO_WritePin(AUDIO_B2_PORT, AUDIO_B2_PIN, (code & 0x04) ? GPIO_PIN_SET : GPIO_PIN_RESET);
		HAL_GPIO_WritePin(AUDIO_B1_PORT, AUDIO_B1_PIN, (code & 0x02) ? GPIO_PIN_SET : GPIO_PIN_RESET);

    audio_busy = 1;
    audio_tick = HAL_GetTick();
}

void Audio_Task(void)
{
  if (audio_busy == 1)
  {
    if ((HAL_GetTick() - audio_tick) >= AUDIO_PULSE_MS)
    {
      Audio_Clear();
      audio_busy = 0;
    }
  }
}

void Relay_All_Off(void)
{
    M1_Pins(0, 0);
    M2_Pins(0, 0);
}

void Conveyor_ResetToIdle(void)
{
    Relay_All_Off();

    m1_state = M1_IDLE;
    m2_state = M2_IDLE;

    m1_locked = 0;
    m2_locked = 0;
}

void UART_SendText(const char *msg)
{
    uint16_t len = 0;

    while (msg[len] != '\0')
    {
        len++;
    }

    HAL_UART_Transmit(&huart1, (uint8_t *)msg, len, 20);
}

void InputFilter_Init(InputFilter_t *f, GPIO_PinState raw)
{
    f->raw_last = raw;
    f->stable = raw;
    f->last_change_tick = HAL_GetTick();
    f->active_event = 0;
}

void InputFilter_Update(InputFilter_t *f, GPIO_PinState raw, GPIO_PinState active_level)
{
    f->active_event = 0;

    if (raw != f->raw_last)
    {
        f->raw_last = raw;
        f->last_change_tick = HAL_GetTick();
    }

    if ((HAL_GetTick() - f->last_change_tick) >= INPUT_DEBOUNCE_MS)
    {
        if (f->stable != f->raw_last)
        {
            GPIO_PinState old_stable = f->stable;
            f->stable = f->raw_last;

            if (old_stable != active_level && f->stable == active_level)
            {
                f->active_event = 1;   // vua co tin hieu hop le
            }
        }
    }
}

uint8_t InputFilter_IsActive(InputFilter_t *f, GPIO_PinState active_level)
{
    return (f->stable == active_level);
}
