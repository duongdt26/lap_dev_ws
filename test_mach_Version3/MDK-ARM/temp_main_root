{
  HAL_GPIO_WritePin(M1_A11_PORT, M1_A11_PIN, a11 ? RELAY_ON : RELAY_OFF);
  HAL_GPIO_WritePin(M1_A12_PORT, M1_A12_PIN, a12 ? RELAY_ON : RELAY_OFF);
}

void M2_Pins(uint8_t a15, uint8_t b3)
{
  HAL_GPIO_WritePin(M2_A15_PORT, M2_A15_PIN, a15 ? RELAY_ON : RELAY_OFF);
  HAL_GPIO_WritePin(M2_B3_PORT, M2_B3_PIN, b3 ? RELAY_ON : RELAY_OFF);
}

