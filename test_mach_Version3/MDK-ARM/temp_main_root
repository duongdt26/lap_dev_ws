/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART1_UART_Init();
  /* USER CODE BEGIN 2 */
	M1_Pins(0, 0);
	M2_Pins(0, 0);

	Audio_Clear();
	
	InputFilter_Init(&btn_emer_filter,  HAL_GPIO_ReadPin(GPIOB, Button_EMER_Pin));
	InputFilter_Init(&btn_stop_filter,  HAL_GPIO_ReadPin(GPIOB, Button_STOP_Pin));
	InputFilter_Init(&btn_start_filter, HAL_GPIO_ReadPin(GPIOB, Button_START_Pin));
	InputFilter_Init(&btn_reset_filter, HAL_GPIO_ReadPin(GPIOB, Button_RESET_Pin));

	InputFilter_Init(&bumper1_filter, HAL_GPIO_ReadPin(GPIOB, Bumper_S1_Pin));
	InputFilter_Init(&bumper2_filter, HAL_GPIO_ReadPin(GPIOB, Bumper_S2_Pin));

	m1_state = M1_IDLE;
	m2_state = M2_IDLE;
	
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
		
		uint8_t nowS1 = S1;
		uint8_t nowS2 = S2;
		uint8_t nowS3 = S3;
		uint8_t nowS4 = S4;
		
		#if USE_EMERGENCY
		InputFilter_Update(&btn_emer_filter, HAL_GPIO_ReadPin(GPIOB, Button_EMER_Pin), EMER_ACTIVE_LEVEL);

		uint8_t nowEMER = InputFilter_IsActive(&btn_emer_filter, EMER_ACTIVE_LEVEL);
		uint8_t emer_on = btn_emer_filter.active_event;
		#else
		uint8_t nowEMER = 0;
		uint8_t emer_on = 0;
		flag_emer_irq = 0;
		#endif
		InputFilter_Update(&btn_stop_filter,  HAL_GPIO_ReadPin(GPIOB, Button_STOP_Pin),  BUTTON_ACTIVE_LEVEL);
		InputFilter_Update(&btn_start_filter, HAL_GPIO_ReadPin(GPIOB, Button_START_Pin), BUTTON_ACTIVE_LEVEL);
		InputFilter_Update(&btn_reset_filter, HAL_GPIO_ReadPin(GPIOB, Button_RESET_Pin), BUTTON_ACTIVE_LEVEL);

		InputFilter_Update(&bumper1_filter, HAL_GPIO_ReadPin(GPIOB, Bumper_S1_Pin), BUMPER_ACTIVE_LEVEL);
		InputFilter_Update(&bumper2_filter, HAL_GPIO_ReadPin(GPIOB, Bumper_S2_Pin), BUMPER_ACTIVE_LEVEL);

		uint8_t nowSTOP = InputFilter_IsActive(&btn_stop_filter, BUTTON_ACTIVE_LEVEL);
		uint8_t nowSTART = InputFilter_IsActive(&btn_start_filter, BUTTON_ACTIVE_LEVEL);
		uint8_t nowRESET = InputFilter_IsActive(&btn_reset_filter, BUTTON_ACTIVE_LEVEL);

		uint8_t nowBUMPER1 = InputFilter_IsActive(&bumper1_filter, BUMPER_ACTIVE_LEVEL);
		uint8_t nowBUMPER2 = InputFilter_IsActive(&bumper2_filter, BUMPER_ACTIVE_LEVEL);

		uint8_t stop_on = btn_stop_filter.active_event;
		uint8_t start_on = btn_start_filter.active_event;
		uint8_t reset_on = btn_reset_filter.active_event;
		uint8_t bumper1_on = bumper1_filter.active_event;
		uint8_t bumper2_on = bumper2_filter.active_event;

		uint8_t allow_conveyor_logic = 1;
		uint8_t control_audio_sent = 0;

		/* ================= EMERGENCY - UU TIEN CAO NHAT ================= */
		if (nowEMER || flag_emer_irq)
		{
				Conveyor_ResetToIdle();

				if (flag_emer_irq || emer_on)
				{
						UART_SendText(UART_MSG_EMERGENCY);
						Audio_SendHex(AUDIO_CODE_BAI_16);
						emer_audio_tick = HAL_GetTick();
						control_audio_sent = 1;
						flag_emer_irq = 0;
				}

				/* Khi EMER con tin hieu thi lap lai bai 16 */
				if (nowEMER)
				{
						if ((HAL_GetTick() - emer_audio_tick) >= EMER_AUDIO_REPEAT_MS)
						{
								Audio_SendHex(AUDIO_CODE_BAI_16);
								emer_audio_tick = HAL_GetTick();
								control_audio_sent = 1;
						}
				}

				allow_conveyor_logic = 0;
		}
		else
		{
				emer_audio_tick = 0;

				/* ================= STOP - KHOA TAM THOI DEN KHI RESET ================= */
				if ((flag_stop_irq || stop_on) && stop_locked == 0)
				{
						stop_locked = 1;
						system_started = 0;

						Conveyor_ResetToIdle();

						UART_SendText(UART_MSG_STOP);
						Audio_SendHex(AUDIO_CODE_BAI_17);
						control_audio_sent = 1;

						flag_stop_irq = 0;
				}

				/* ================= RESET - MO KHOA STOP VA VE TRANG THAI NHU START ================= */
				if (reset_on)
				{
						stop_locked = 0;
						system_started = 1;

						flag_stop_irq = 0;
						flag_bumper1_irq = 0;
						flag_bumper2_irq = 0;

						Conveyor_ResetToIdle();

						UART_SendText(UART_MSG_RESET);
						Audio_SendHex(AUDIO_CODE_BAI_19);
						control_audio_sent = 1;
				}

				/* ================= START - BAT DAU CHO PHEP CHUONG TRINH CHAY ================= */
				if (start_on && stop_locked == 0)
				{
						system_started = 1;

						Conveyor_ResetToIdle();

						UART_SendText(UART_MSG_START);
						Audio_SendHex(AUDIO_CODE_BAI_18);
						control_audio_sent = 1;
				}

				/* Neu chua START hoac dang STOP LOCK thi cam bien/motor khong co tac dung */
				if (system_started == 0 || stop_locked == 1)
				{
						Relay_All_Off();
						allow_conveyor_logic = 0;
				}

				/* ================= BUMPER - DUNG NGAY NHUNG KHONG KHOA ================= */
				if (allow_conveyor_logic == 1)
				{
						if (nowBUMPER1 || nowBUMPER2 || flag_bumper1_irq || flag_bumper2_irq)
						{
								Relay_All_Off();

								if (flag_bumper1_irq || bumper1_on)
								{
										UART_SendText(UART_MSG_BUMPER1);
										Audio_SendHex(AUDIO_CODE_BAI_20);
										control_audio_sent = 1;
										flag_bumper1_irq = 0;
								}

								if (flag_bumper2_irq || bumper2_on)
								{
										UART_SendText(UART_MSG_BUMPER2);
										Audio_SendHex(AUDIO_CODE_BAI_21);
										control_audio_sent = 1;
										flag_bumper2_irq = 0;
								}

								allow_conveyor_logic = 0;
						}
				}
		}
		
		if (allow_conveyor_logic == 1)
			{
				uint8_t s1_on = (nowS1 && !oldS1);
				uint8_t s2_on = (nowS2 && !oldS2);
				uint8_t s3_on = (nowS3 && !oldS3);
				uint8_t s4_on = (nowS4 && !oldS4);

			/* ===== AUDIO: cam bien nao vua co vat thi phat bai tuong ung ===== */
			 if (control_audio_sent == 0)
				{
				if (s1_on)
					{
							Audio_SendHex(AUDIO_CODE_BAI_1);   // bai 1 = 0x10
					}
					else if (s2_on)
					{
							Audio_SendHex(AUDIO_CODE_BAI_2);   // bai 2 = 0x08
					}
					else if (s3_on)
					{
							Audio_SendHex(AUDIO_CODE_BAI_3);   // bai 3 = 0x04
					}
					else if (s4_on)
					{
							Audio_SendHex(AUDIO_CODE_BAI_4);   // bai 4 = 0x02
					}
				}
			/* ================= MOTOR 1: S1 <-> S3 ================= */
			switch (m1_state)
			{
				case M1_IDLE:
					
						M1_Pins(0, 0);   // moi vao tat A11, A12	
						
						if (m1_locked == 1)
						{
								break; // ? CAM CHAY LAI
						}
						if (nowS1 && !nowS3)
						{
								M1_Pins(1, 0);        // S1 nhan -> kich A11
								m1_state = M1_RUN_S1_TO_S3;
						}
						else if (nowS3 && !nowS1)
						{
								M1_Pins(0, 1);        // S3 nhan -> kich A12
								m1_state = M1_RUN_S3_TO_S1;
						}
						break;

				case M1_RUN_S1_TO_S3:
					
						M1_Pins(1, 0);            // dang chay tu S1 toi S3

						if (nowS3)
						{
								M1_Pins(1, 1);        // toi S3 -> kich ca A11 + A12 de dung/giu
								m1_locked = 1;   			// KH?A LU?N
								m1_state = M1_HOLD_AT_S3;
						}
						break;

				case M1_HOLD_AT_S3:						//Hang dang nam tai S3 cho nen bat buoc giu A11 + A12, khong cho nhay sang chieu nguoc.

								M1_Pins(1, 1);        // S3 con tin hieu -> giu dung
				
						// CHI THOAT KHI:
						if (!nowS3 && m1_locked == 1)
						{	
								m1_locked = 0;        // MO KHOA
								M1_Pins(0, 0);        // S3 mat tin hieu -> tat A11, A12
								m1_state = M1_IDLE;   // bat dau lai chu ky moi
						}
						break;

				case M1_RUN_S3_TO_S1:
					
						M1_Pins(0, 1);            // dang chay tu S3 ve S1

						if (nowS1)
						{
								M1_Pins(1, 1);        // toi S1 -> kich ca A11 + A12 de dung/giu
								m1_locked = 1;   			// KH?A LU?N
								m1_state = M1_HOLD_AT_S1;
						}	
						break;

				case M1_HOLD_AT_S1:						//Hang dang nam tai S1 cho nen bat buoc giu A11 + A12, khong cho nhay sang chieu nguoc.

								M1_Pins(1, 1);        // S1 con tin hieu -> giu dung
		 
						// CHI THOAT KHI:
						if (!nowS1 && m1_locked == 1)
						{
								m1_locked = 0;        // MO KHOA
								M1_Pins(0, 0);        // S1 mat tin hieu -> tat A11, A12
								m1_state = M1_IDLE;
						}
						break;

				default:
						M1_Pins(0, 0);
						m1_state = M1_IDLE;
						break;
		}
			/* ================= MOTOR 2: S2 <-> S4 ================= */
			switch (m2_state)
			{
				case M2_IDLE:
						M2_Pins(0, 0);   // moi vao tat A15, B3

						if (m2_locked == 1)
						{
								break; // ? CAM CHAY LAI
						}
						if (nowS2 && !nowS4)
						{
								M2_Pins(0, 1);        // S2 nhan -> kich B3A15
								m2_state = M2_RUN_S2_TO_S4;
						}
						else if (nowS4 && !nowS2)
						{
								M2_Pins(1, 0);        // S4 nhan -> kich A15
								m2_state = M2_RUN_S4_TO_S2;
						}
						break;

				case M2_RUN_S2_TO_S4:
					
						M2_Pins(0, 1);            // dang chay tu S2 toi S4

						if (nowS4)
						{
								M2_Pins(1, 1);        // toi S4 -> kich ca A15 + B3 de dung/giu
								m2_locked = 1;   			// KH?A LU?N
								m2_state = M2_HOLD_AT_S4;
						}
						break;

				case M2_HOLD_AT_S4:						//Hang dang nam tai S2 cho nen bat buoc giu A11 + A12, khong cho nhay sang chieu nguoc.

								M2_Pins(1, 1);        // S4 con tin hieu -> giu dung
				
						if (!nowS4 && m2_locked == 1)
						{
								m2_locked = 0;        // MO KHOA
								M2_Pins(0, 0);        // S4 mat tin hieu -> tat A15, B3
								m2_state = M2_IDLE;
						}
						break;

				case M2_RUN_S4_TO_S2:
					
						M2_Pins(1, 0);            // dang chay tu S4 ve S2

						if (nowS2)
						{
								M2_Pins(1, 1);        // toi S2 -> kich ca A15 + B3 de dung/giu
								m2_locked = 1;   			// KH?A LU?N
								m2_state = M2_HOLD_AT_S2;
						}
						break;

				case M2_HOLD_AT_S2:          //Hang dang nam tai S2 cho nen bat buoc giu A11 + A12, khong cho nhay sang chieu nguoc.

								M2_Pins(1, 1);        // S2 con tin hieu -> giu dung
				
						if (!nowS2 && m2_locked == 1)
						{
								M2_Pins(0, 0);        // S2 mat tin hieu -> tat A15, B3
								m2_locked = 0;        // MO KHOA
								m2_state = M2_IDLE;
						}
						break;

				default:
						M2_Pins(0, 0);
						m2_state = M2_IDLE;
						break;
			}
		}
		else
			{
					Relay_All_Off();
			}
		/* ===== AUDIO: phat 1 lan khi cam bien vua co vat (canh xuong) ===== */
		Audio_Task();

		oldS1 = nowS1;
		oldS2 = nowS2;
		oldS3 = nowS3;
		oldS4 = nowS4;

		HAL_Delay(20);

  /* USER CODE END 3 */
}
